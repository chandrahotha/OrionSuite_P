{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Orion Engine Suite",
          "version": "0.9.1",
          "informationUri": "https://www.npmjs.com/package/@orionscanner/cli"
        }
      },
      "results": [
        {
          "ruleId": "EXAMPLE-REDACTED",
          "level": "error",
          "message": { "text": "Illustrative redacted finding. Not from a real scan." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/example.REDACTED" },
                "region": { "startLine": 1 }
              }
            }
          ]
        }
      ]
    }
  ]
}
